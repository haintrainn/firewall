<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="20dp" android:height="32dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:width="24dp" android:height="24dp" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/fw_on_primary" />
                </shape>
            </item>
            <item android:width="16dp" android:height="16dp" android:gravity="center"
                android:drawable="@drawable/ic_switch_check" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="20dp" android:height="32dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:width="16dp" android:height="16dp" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/fw_outline" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
