<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fw_primary" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="6dp" android:right="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fw_surface_highest" />
            <stroke android:width="2dp" android:color="@color/fw_outline" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="6dp" android:right="6dp" />
        </shape>
    </item>
</selector>
